# Real Auko video exports (4K masters, hundreds of MB) — GitHub hard-rejects
# files over 100MB anyway. Keep the originals locally; don't push them.
# auko-walkthrough-web.mp4 is the compressed 1080p proxy actually used on the
# live page (~20MB) — that one ships.
assets/video/*
!assets/video/auko-walkthrough-web.mp4

# Original personal-photo uploads (full-size, mixed-case names). Web-weight,
# clean-named copies of what's actually used live in assets/photo/personal/ —
# these originals are the source, kept locally, not needed by the deploy.
assets/photo/Landscapes/
assets/photo/Portraits/

# OS cruft
.DS_Store

# Editor/tooling scratch
.impeccable/
